<?xml version="1.0" encoding="utf-8"?>
<!-- An interview answer row: roomy, start-aligned, readable when long. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/c_ripple_light">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/c_accent_soft" />
                    <corners android:radius="@dimen/radius_control" />
                    <stroke android:width="1.5dp" android:color="?attr/c_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/c_surface2" />
                    <corners android:radius="@dimen/radius_control" />
                    <stroke android:width="1dp" android:color="?attr/c_border" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
