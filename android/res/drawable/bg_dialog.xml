<?xml version="1.0" encoding="utf-8"?>
<!-- Level-3 surface: pops above the app instead of blending into it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_surface3" />
            <corners android:radius="@dimen/radius_dialog" />
            <stroke android:width="1dp" android:color="?attr/c_border_strong" />
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_hairline" />
        </shape>
    </item>
</layer-list>
