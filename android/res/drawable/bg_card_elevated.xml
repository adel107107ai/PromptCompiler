<?xml version="1.0" encoding="utf-8"?>
<!-- Level-1 surface: card on the window, with a top light source and a real border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_surface" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="?attr/c_border" />
        </shape>
    </item>
    <item android:left="16dp" android:right="16dp" android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/c_hairline" />
        </shape>
    </item>
</layer-list>
