<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">?attr/c_surface</item>
        <item name="android:colorPrimaryDark">?attr/c_bg</item>
        <item name="android:colorAccent">?attr/c_accent</item>
        <item name="android:colorBackground">?attr/c_bg</item>
        <item name="android:windowBackground">?attr/c_bg</item>
        <item name="android:textColorPrimary">?attr/c_text</item>
        <item name="android:textColorSecondary">?attr/c_muted</item>
        <item name="android:textColorHint">?attr/c_hint</item>
        <item name="android:statusBarColor">?attr/c_bg</item>
        <item name="android:navigationBarColor">?attr/c_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textColor">?attr/c_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">?attr/c_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BtnPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">?attr/c_on_accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BtnGhost" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BtnChip" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_chip</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxWidth">190dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="InputField">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textColorHint">?attr/c_hint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:gravity">top|start</item>
    </style>

    <style name="CodeBlock">
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Badge">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">?attr/c_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="BtnRow" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Icon-only button: the glyph carries the meaning, the target stays 44dp. -->
    <style name="BtnIcon" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">?attr/c_muted</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- One tappable answer in the interview: same shape for every option. -->
    <style name="OptionRow" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- The recommended answer: same geometry, accent weight. -->
    <style name="OptionRow.Recommended">
        <item name="android:textColor">?attr/c_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Navigation: a clear pair, identical height and radius, one filled and one outlined. -->
    <style name="NavPrimary" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_nav_primary</item>
        <item name="android:textColor">?attr/c_on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="NavGhost" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_nav_ghost</item>
        <item name="android:textColor">?attr/c_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">?attr/c_accent</item>
        <item name="android:textColorPrimary">?attr/c_text</item>
        <item name="android:colorBackground">?attr/c_surface</item>
        <item name="android:windowBackground">@drawable/bg_card</item>
    </style>
</resources>
